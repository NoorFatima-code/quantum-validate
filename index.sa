class QValidate {
  # ---------- character checks (ord() se number compare) ----------

  fn _is_digit(c) {
    let n = ord(c)
    return n >= 48 && n <= 57
  }

  fn _is_upper(c) {
    let n = ord(c)
    return n >= 65 && n <= 90
  }

  fn _is_lower(c) {
    let n = ord(c)
    return n >= 97 && n <= 122
  }

  fn _all_digits(s) {
    if len(s) == 0 {
      return false
    }
    let i = 0
    while i < len(s) {
      if !self._is_digit(s[i]) {
        return false
      }
      i = i + 1
    }
    return true
  }

  # ---------- string helpers ----------

  fn _count_char(s, ch) {
    let count = 0
    let i = 0
    while i < len(s) {
      if s[i] == ch {
        count = count + 1
      }
      i = i + 1
    }
    return count
  }

  fn _index_of(s, ch) {
    let i = 0
    while i < len(s) {
      if s[i] == ch {
        return i
      }
      i = i + 1
    }
    return -1
  }

  fn _last_index_of(s, ch) {
    let i = len(s) - 1
    while i >= 0 {
      if s[i] == ch {
        return i
      }
      i = i - 1
    }
    return -1
  }

  fn _starts_with(s, prefix) {
    if len(prefix) > len(s) {
      return false
    }
    let i = 0
    while i < len(prefix) {
      if s[i] != prefix[i] {
        return false
      }
      i = i + 1
    }
    return true
  }

  fn _has_space(s) {
    return self._count_char(s, " ") > 0
  }

  # dash aur space hata kar baqi characters wapas deta hai
  fn _strip_separators(s) {
    let out = ""
    let i = 0
    while i < len(s) {
      if s[i] != "-" && s[i] != " " {
        out = out + s[i]
      }
      i = i + 1
    }
    return out
  }

  # s[start .. end] wapas deta hai
  fn _tail(s, start) {
    let out = ""
    let i = start
    while i < len(s) {
      out = out + s[i]
      i = i + 1
    }
    return out
  }

  # ---------- public API ----------

  # email: ek '@', local part khali nahi, domain me '.', koi space nahi
  fn is_email(s) {
    if len(s) < 5 {
      return false
    }
    if self._has_space(s) {
      return false
    }
    if self._count_char(s, "@") != 1 {
      return false
    }
    let at = self._index_of(s, "@")
    if at < 1 {
      return false
    }
    let dot = self._last_index_of(s, ".")
    if dot < at + 2 {
      return false
    }
    if dot >= len(s) - 1 {
      return false
    }
    return true
  }

  # url: http:// ya https:// se shuru, host me kam az kam ek '.', koi space nahi
  fn is_url(s) {
    if self._has_space(s) {
      return false
    }
    let rest = ""
    if self._starts_with(s, "https://") {
      rest = self._tail(s, 8)
    } else {
      if self._starts_with(s, "http://") {
        rest = self._tail(s, 7)
      } else {
        return false
      }
    }
    if len(rest) < 3 {
      return false
    }
    let dot = self._index_of(rest, ".")
    if dot < 1 {
      return false
    }
    if dot >= len(rest) - 1 {
      return false
    }
    return true
  }

  # password: 8+ chars, upper, lower, digit aur ek special character
  fn is_strong_password(s) {
    if len(s) < 8 {
      return false
    }
    let has_upper = false
    let has_lower = false
    let has_digit = false
    let has_special = false
    let i = 0
    while i < len(s) {
      let c = s[i]
      if self._is_upper(c) {
        has_upper = true
      } else {
        if self._is_lower(c) {
          has_lower = true
        } else {
          if self._is_digit(c) {
            has_digit = true
          } else {
            has_special = true
          }
        }
      }
      i = i + 1
    }
    return has_upper && has_lower && has_digit && has_special
  }

  # Pakistani mobile: 03XXXXXXXXX, +923XXXXXXXXX, 923XXXXXXXXX
  # dash aur space allowed (0300-1234567, +92 300 1234567)
  fn is_pk_phone(s) {
    let plus = false
    let t = s
    if self._starts_with(t, "+") {
      plus = true
      t = self._tail(t, 1)
    }
    t = self._strip_separators(t)
    if !self._all_digits(t) {
      return false
    }
    if !plus && self._starts_with(t, "03") && len(t) == 11 {
      return true
    }
    if self._starts_with(t, "923") && len(t) == 12 {
      return true
    }
    return false
  }

  # CNIC: 13 digits, ya XXXXX-XXXXXXX-X format
  fn is_cnic(s) {
    if self._has_space(s) {
      return false
    }
    let dashes = self._count_char(s, "-")
    if dashes == 0 {
      return len(s) == 13 && self._all_digits(s)
    }
    if dashes == 2 && len(s) == 15 {
      if s[5] == "-" && s[13] == "-" {
        return self._all_digits(self._strip_separators(s))
      }
    }
    return false
  }

  # CNIC ko XXXXX-XXXXXXX-X format me badalta hai (invalid ho to "")
  fn format_cnic(s) {
    if !self.is_cnic(s) {
      return ""
    }
    let d = self._strip_separators(s)
    let out = ""
    let i = 0
    while i < len(d) {
      if i == 5 || i == 12 {
        out = out + "-"
      }
      out = out + d[i]
      i = i + 1
    }
    return out
  }
}

QValidate = QValidate()
